<!-- uwuCurrency's .msi (docs/desktop-features-spec.md §16), for Group Policy and msiexec: x64, per
     user, a MajorUpgrade so each version replaces the last, Start menu and desktop shortcuts, and
     uwu:// links. Its UpgradeCode never changes. The app can't update an .msi install itself; it
     says when there's a new version, with a link to download it.

     Built by .github/workflows/build-desktop.yml with WiX 5:
       wix build uwucurrency.wxs -arch x64 -d Version=1.0.0 -d Source=<x64 Release folder> -o uwucurrency-1.0.0.msi -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="uwuCurrency" Manufacturer="Augy Studios" Version="$(var.Version)"
           UpgradeCode="923f5cd7-cc80-45a5-8bd8-bca2b7261e5b" Scope="perUser" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer uwuCurrency is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="AppIcon" SourceFile="$(var.Source)\data\flutter_assets\assets\images\tray.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://currency.uwuapps.org" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="uwuCurrency" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.Source)\**" />
    </ComponentGroup>

    <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="a67fa15d-e4e2-4575-adbe-66e13f829d81">
      <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="uwuCurrency" Target="[INSTALLFOLDER]uwuCurrency.exe" WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="Desktop" Directory="DesktopFolder" Name="uwuCurrency" Target="[INSTALLFOLDER]uwuCurrency.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu" Value="URL:UwU Apps link" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu" Name="URL Protocol" Value="" Type="string" />
      <RegistryValue Root="HKCU" Key="Software\Classes\uwu\shell\open\command" Value="&quot;[INSTALLFOLDER]uwuCurrency.exe&quot; &quot;%1&quot;" Type="string" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>
  </Package>
</Wix>
