<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's adaptive icon (Android 8+): the ground colour, and the coins and arrows drawn at
     80% by tool/make_icons.py, inside the 66 dp circle every launcher's mask keeps. -->
